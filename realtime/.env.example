# Ambiente: realtime (Elixir/Phoenix)
# Copie para .env e preencha (o .env é ignorado pelo git)

# Porta do servidor
PORT=4000

# Chave secreta base (obrigatória em produção). Gere com: mix phx.gen.secret
SECRET_KEY_BASE=generate_a_secret_key_here

# Chave secreta usada para validar o JWT emitido pela API (Python/FastAPI).
# Deve ser a MESMA da variável SECRET_KEY da API, com o mesmo algoritmo (HS256).
SECRET_KEY=generate_a_secret_key_here

# Conexão com PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=jcl_chat
POSTGRES_USER=jcl
POSTGRES_PASSWORD=jcl_dev_password
