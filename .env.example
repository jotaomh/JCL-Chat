# ============================================================
#  JCL-Chat — Variáveis de ambiente (exemplo)
# ============================================================
#  Copie este arquivo para ".env" e preencha os valores.
#  O arquivo ".env" está no .gitignore (NUNCA suba ele para o Git).
#
#  Gere chaves secretas com, por exemplo:
#    openssl rand -hex 32
# ============================================================

# ---------- Banco de dados (PostgreSQL) ----------
POSTGRES_DB=jcl_chat
POSTGRES_USER=jcl
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432

# ---------- Backend realtime (Elixir/Phoenix) ----------
SECRET_KEY_BASE=generate_a_random_secret_key_here

# ---------- API (Python/FastAPI) ----------
# SECRET_KEY e ALGORITHM também são usados pelo serviço realtime
# (Elixir/Phoenix) para validar o JWT — mantenha sempre iguais nos dois.
SECRET_KEY=generate_a_random_secret_key_here
ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Frontend (React/Vite) ----------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=http://localhost:4000
