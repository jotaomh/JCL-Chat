# Variáveis de ambiente para o frontend do JCL-Chat
# Copie este arquivo para .env e preencha os valores

# URL do backend de API REST (FastAPI)
VITE_API_URL=http://localhost:8000

# URL do servidor WebSocket (Elixir/Phoenix)
VITE_WS_URL=http://localhost:4000

# Porta do frontend (Vite)
VITE_PORT=3000
