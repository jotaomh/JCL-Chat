# Ambiente: api (Python/FastAPI)
# Copie para .env e preencha (o .env é ignorado pelo git)

# Porta da API
API_PORT=8000

# Chave secreta para assinar JWT (gerar com: openssl rand -hex 32)
SECRET_KEY=generate_a_secret_key_here
ALGORITHM=HS256

# Conexão com PostgreSQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=jcl_chat
POSTGRES_USER=jcl
POSTGRES_PASSWORD=jcl_dev_password

# CORS - origens permitidas para o frontend
CORS_ORIGINS=["http://localhost:3000"]
